/setup-windows.bat                  @REPLACE-setup-owner
/setup-mac.command                  @REPLACE-setup-owner
/start-mac.command                  @REPLACE-setup-owner
/requirements.txt                   @REPLACE-setup-owner
/requirements-dev.txt               @REPLACE-setup-owner

# Camera tracking
/tracking/                          @REPLACE-hardware-owner
/tracking_*                         @REPLACE-hardware-owner

# Rules for people and agents
/AGENTS.md                          @REPLACE-lead
/CLAUDE.md                          @REPLACE-lead
/.github/                           @REPLACE-lead

