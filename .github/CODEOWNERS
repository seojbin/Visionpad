# Code owners: who reviews which folder. Mirrors AGENTS.md: a feature task touches only game/<name>/;
# engine/ needs approval. Every handle is a PLACEHOLDER: replace @REPLACE-* with GitHub users or teams
# that have write access (GitHub ignores owners without it). Later rules override earlier ones.

# Default, and files at the root (README, AGENTS.md, launchers)
*                                   @REPLACE-lead
/install-windows.bat                @REPLACE-setup-owner
/install-mac.command                @REPLACE-setup-owner
/start-windows.bat                  @REPLACE-setup-owner
/start-mac.command                  @REPLACE-setup-owner

# Shared engine (explicit approval)
/engine/                            @REPLACE-engine-owner
/engine/config/                     @REPLACE-engine-owner @REPLACE-lead
/engine/services/saves.py           @REPLACE-engine-owner @REPLACE-lead
/engine/tests/fixtures/saves/       @REPLACE-engine-owner @REPLACE-lead
/engine/web/                        @REPLACE-web-owner
/engine/web/core/pad/               @REPLACE-hardware-owner
/engine/web/spectator/display.js    @REPLACE-web-owner @REPLACE-lead
/engine/web/audio/                  @REPLACE-audio-owner
/engine/launcher/                   @REPLACE-setup-owner
/engine/requirements*.txt           @REPLACE-setup-owner
/engine/tracking/                   @REPLACE-hardware-owner

# Feature list and registration order (shared by every feature)
/game/__init__.py                   @REPLACE-engine-owner
/game/README.md                     @REPLACE-lead

# Rules for people and agents
/AGENTS.md                          @REPLACE-lead
/.claude/                           @REPLACE-lead
/.github/                           @REPLACE-lead

# Features: one owner per feature. Sounds and images also need the asset owner.
/game/cooking/                      @REPLACE-cooking-owner
/game/cooking/audio/                @REPLACE-cooking-owner @REPLACE-audio-owner
/game/farming/                      @REPLACE-farming-owner
/game/farming/audio/                @REPLACE-farming-owner @REPLACE-audio-owner
/game/fishing/                      @REPLACE-fishing-owner
/game/fishing/audio/                @REPLACE-fishing-owner @REPLACE-audio-owner
/game/fishing/assets/               @REPLACE-fishing-owner @REPLACE-web-owner
/game/flowers/                      @REPLACE-flowers-owner
/game/flowers/assets/               @REPLACE-flowers-owner @REPLACE-web-owner
/game/harvest/                      @REPLACE-harvest-owner
/game/harvest/audio/                @REPLACE-harvest-owner @REPLACE-audio-owner
/game/home/                         @REPLACE-home-owner
/game/inventory/                    @REPLACE-inventory-owner
/game/minimap/                      @REPLACE-minimap-owner
/game/mining/                       @REPLACE-mining-owner
/game/mining/audio/                 @REPLACE-mining-owner @REPLACE-audio-owner
/game/npc/                          @REPLACE-npc-owner
/game/npc/assets/                   @REPLACE-npc-owner @REPLACE-web-owner
/game/research/                     @REPLACE-research-owner
/game/seafood/                      @REPLACE-seafood-owner
/game/shop/                         @REPLACE-shop-owner
/game/village/                      @REPLACE-village-owner
