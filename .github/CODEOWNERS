# Code owners: who reviews which folder. Mirrors the ownership table in AGENTS.md.
# Every handle below is a PLACEHOLDER. Replace @REPLACE-* with real GitHub users or teams that
# have write access; GitHub ignores owners without it. Later rules override earlier ones.

# Default: anything not listed below
*                                   @REPLACE-lead

# Core engine, shared services and app (explicit approval, AGENTS.md)
/engine/                         @REPLACE-core-owner
/engine/core/                    @REPLACE-core-owner
/engine/display/                 @REPLACE-core-owner
/engine/spectator/               @REPLACE-core-owner
/engine/services/                @REPLACE-core-owner
/engine/server/                     @REPLACE-core-owner
/game/__init__.py     @REPLACE-core-owner
# engine/config/game.json is one file, so feature config sections are reviewed by the core owner too.
/config/                            @REPLACE-core-owner

# Save format: engine attribute names, key order and fixtures
/engine/services/saves.py        @REPLACE-core-owner @REPLACE-lead
/tests/fixtures/saves/              @REPLACE-core-owner @REPLACE-lead

# Shared client, companion window and assets
/engine/web/                               @REPLACE-web-owner
/engine/web/core/                          @REPLACE-web-owner
/engine/web/core/pad/                      @REPLACE-hardware-owner
/engine/web/game.html                      @REPLACE-web-owner
/engine/web/spectator/                     @REPLACE-web-owner
/engine/web/spectator/display.js           @REPLACE-web-owner @REPLACE-lead
/engine/web/audio/                         @REPLACE-audio-owner
*.mp3                               @REPLACE-audio-owner
*.png                               @REPLACE-web-owner

# Shared tests, baseline and refactor records
/tests/                             @REPLACE-core-owner
/docs/refactor/                     @REPLACE-lead

# Setup, launchers and tools
/tools/                             @REPLACE-setup-owner
